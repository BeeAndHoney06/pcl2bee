    <!-- Setup.Launch.Options.InstanceIsolation -->

    <sys:String x:Key="Setup.Launch.Options.InstanceIsolation.All">Aislar todas las instancias</sys:String>
    <sys:String x:Key="Setup.Launch.Options.InstanceIsolation.All.ToolTip">Los archivos guardados, modificados, paquetes de recursos y otros archivos no se comparten entre instancias.&#xA;Los guardados tampoco se compartirán entre instancias de Vanilla, por lo que generalmente no se recomienda.</sys:String>
