    <sys:String x:Key="Setup.Launch.Memory.Auto">Auto</sys:String>
    <sys:String x:Key="Setup.Launch.Memory.Auto.ToolTip">Ajustez dynamiquement la mémoire allouée au jeu en fonction des mods installés et de la mémoire système disponible.</sys:String>
    <sys:String x:Key="Setup.Launch.Memory.AvailableSuffix">Disponible : {0} Gio</sys:String>
    <sys:String x:Key="Setup.Launch.Memory.GameAllocation">Attribution des jeux</sys:String>
    <sys:String x:Key="Setup.Launch.Memory.Max">Mémoire maximale (-Xmx)</sys:String>
