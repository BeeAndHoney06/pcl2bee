    <sys:String x:Key="Setup.Update.Auto.NotifyOnly">Demander une mise à jour</sys:String>
    <sys:String x:Key="Setup.Update.Auto.NotifyOnly.ToolTip">Le lanceur recherchera automatiquement les mises à jour disponibles, puis vous invitera à les télécharger et à les installer.</sys:String>
