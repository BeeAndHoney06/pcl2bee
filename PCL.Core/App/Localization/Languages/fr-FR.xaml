    <sys:String x:Key="Setup.Launch.Options.WindowSize.Maximized">Maximisé</sys:String>
    <sys:String x:Key="Setup.Launch.Options.WindowSize.ModernUiWarning">Remarque : Si le mod Modern UI est installé sur votre instance, ce paramètre ne prendra pas effet.</sys:String>
    <sys:String x:Key="Setup.Launch.Options.WindowSize.SameAsLauncher">Identique à la taille du lanceur</sys:String>
