    <sys:String x:Key="Setup.Launch.Memory.Title">Mémoire de jeu</sys:String>
    <sys:String x:Key="Setup.Launch.Memory.UsedTotal">Mémoire utilisée/installée</sys:String>
    <sys:String x:Key="Setup.Launch.Memory.Warning.Java32Bit">Java 32 bits ne peut allouer que jusqu'à 1 Gio de mémoire. Il est fortement recommandé d'utiliser Java 64 bits !</sys:String>
    <sys:String x:Key="Setup.Launch.Memory.Warning.TooMuch">Vous avez alloué trop de mémoire au jeu, ce qui peut provoquer des plantages. Il est recommandé d'utiliser Auto en premier !</sys:String>

    <!-- Setup.Launch.Options -->

    <sys:String x:Key="Setup.Launch.Options.CustomInfo.Label">Texte personnalisé</sys:String>
    <sys:String x:Key="Setup.Launch.Options.CustomInfo.ToolTip">Ce texte sera affiché dans l'écran titre et l'écran de débogage F3.</sys:String>
    <sys:String x:Key="Setup.Launch.Options.IpStack.Ipv4">IPv4 préféré</sys:String>
    <sys:String x:Key="Setup.Launch.Options.IpStack.Ipv6">IPv6 préféré</sys:String>
    <sys:String x:Key="Setup.Launch.Options.IpStack.JavaDefault">Java par défaut</sys:String>
    <sys:String x:Key="Setup.Launch.Options.IpStack.Label">Préférence de protocole IP</sys:String>
    <sys:String x:Key="Setup.Launch.Options.IpStack.ToolTip">Définissez la préférence du protocole IP Minecraft via les arguments JVM.&#xA;En général, IPv4 préféré est recommandé pour garantir le bon fonctionnement du lobby PCL2 Bee .&#xA;Si vous avez besoin d'une mise en réseau IPv6 manuelle, vous pouvez choisir une autre option.&#xA;&#xA;IPv4 préféré : -Djava.net.preferIPv4Stack=true&#xA;Par défaut : aucun argument supplémentaire&#xA;IPv6 préféré : -Djava.net.preferIPv6Stack=true</sys:String>
    <sys:String x:Key="Setup.Launch.Options.MsAuth.DeviceCode">Flux de code de périphérique</sys:String>
    <sys:String x:Key="Setup.Launch.Options.MsAuth.Label">Méthode de connexion Microsoft</sys:String>
    <sys:String x:Key="Setup.Launch.Options.MsAuth.ToolTip">Le gestionnaire de compte Web dispose d'un flux de connexion Microsoft plus simple, tandis que le flux de code de périphérique vous permet de vous authentifier sur n'importe quel appareil doté d'un navigateur Web.&#xA;Si vous rencontrez des problèmes avec le gestionnaire de compte Web, essayez d'utiliser Device Code Flow.&#xA;Si vous vous connectez temporairement sur un ordinateur public, Device Code Flow est recommandé.&#xA;&#xA;En raison de problèmes avec certaines dépendances, cette option est temporairement forcée à Device Code Flow.</sys:String>
    <sys:String x:Key="Setup.Launch.Options.MsAuth.WebManager">Gestionnaire de compte Web (temporairement forcé à Device Code Flow)</sys:String>
    <sys:String x:Key="Setup.Launch.Options.Priority.AboveNormal">Élevé (donne la priorité aux performances du jeu, mais peut entraîner un retard d'autres programmes)</sys:String>
    <sys:String x:Key="Setup.Launch.Options.Priority.BelowNormal">Faible (donne la priorité aux autres programmes, mais peut entraîner un ralentissement du jeu ; convient pour une exécution en arrière-plan)</sys:String>
    <sys:String x:Key="Setup.Launch.Options.Priority.High">Très élevé (à utiliser avec prudence, peut avoir de graves conséquences sur d'autres programmes)</sys:String>
    <sys:String x:Key="Setup.Launch.Options.Priority.Label">Priorité du processus</sys:String>
    <sys:String x:Key="Setup.Launch.Options.Priority.Normal">Normal (équilibré)</sys:String>
    <sys:String x:Key="Setup.Launch.Options.Priority.RealTime">Temps réel (exécute le jeu avec la priorité la plus élevée ; à utiliser avec prudence, peut avoir un impact important sur les performances du système)</sys:String>
    <sys:String x:Key="Setup.Launch.Options.Title">Options de lancement</sys:String>
    <sys:String x:Key="Setup.Launch.Options.WindowSize.Custom">Taille personnalisée</sys:String>
    <sys:String x:Key="Setup.Launch.Options.WindowSize.CustomHeightBug.ToolTip">Certaines versions telles que Forge 1.12.2 ont un bug qui empêche le paramètre de hauteur de prendre effet</sys:String>
    <sys:String x:Key="Setup.Launch.Options.WindowSize.Fullscreen">Plein écran</sys:String>
