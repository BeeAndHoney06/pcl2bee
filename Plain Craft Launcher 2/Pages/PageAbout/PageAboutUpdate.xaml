<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="PCL.PageAboutUpdate"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical" Margin="0,10,0,10">
            <local:MyCard Margin="25,15,25,15" Title="{DynamicResource About.Left.Update}">
                <StackPanel Margin="25,40,25,20" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="LabCurrent" FontSize="14" TextWrapping="Wrap" />
                    <WrapPanel ItemHeight="35" Margin="0,18,0,0">
                        <local:MyButton x:Name="BtnCheck" MinWidth="120" ColorType="Highlight" Margin="0,0,10,0"
                                        Text="{DynamicResource About.Update.Check}" Click="BtnCheck_Click" />
                        <local:MyButton x:Name="BtnOpen" MinWidth="120" Visibility="Collapsed"
                                        Text="{DynamicResource About.Update.Open}" Click="BtnOpen_Click" />
                    </WrapPanel>
                    <!-- 仅在有结果时显示，避免空文本渲染成空白色条 -->
                    <local:MyHint x:Name="HintResult" Margin="0,15,0,0" Theme="Blue" Visibility="Collapsed" />
                    <TextBlock x:Name="LabNotes" Margin="0,12,0,0" Opacity="0.75" TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
