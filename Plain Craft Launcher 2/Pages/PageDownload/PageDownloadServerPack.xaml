<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageDownloadServerPack"
    PanScroll="{Binding ElementName=PanBack}">
    <Grid>
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              x:Name="PanBack">
            <Grid Margin="5">
                <!-- 整合包列表视图 -->
                <StackPanel x:Name="PanProjects">
                    <local:MyCard Margin="20,20,20,15" Title="{DynamicResource Download.ServerPack.Intro.Title}"
                                  UseAnimation="False">
                        <StackPanel Margin="25,40,15,20">
                            <TextBlock Margin="0,0,0,11" Text="{DynamicResource Download.ServerPack.Intro.Description}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </local:MyCard>
                    <local:MyCard Margin="20,0,20,15" UseAnimation="False">
                        <Grid Margin="15,10,15,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LabSource" VerticalAlignment="Center" Grid.Column="0"
                                       Text="{DynamicResource Download.ServerPack.Source.Label}" Margin="0,0,12,0" />
                            <local:MyComboBox x:Name="ComboSource" Grid.Column="1">
                                <local:MyComboBoxItem Content="{DynamicResource Download.ServerPack.Source.All}"
                                                      Tag="0" IsSelected="True" />
                                <local:MyComboBoxItem Content="CurseForge" Tag="1" />
                                <local:MyComboBoxItem Content="Modrinth" Tag="2" />
                            </local:MyComboBox>
                        </Grid>
                    </local:MyCard>
                    <local:MySearchBox x:Name="SearchBox" Margin="20,0,20,10"
                                       HintText="{DynamicResource Download.ServerPack.Search.Hint}"
                                       SearchButtonVisibility="Visible" />
                    <StackPanel Name="PanMain" Margin="20,0,20,10">
                        <local:MyHint x:Name="HintError" Theme="Red" HasBorder="True" Visibility="Collapsed"
                                      Margin="0,0,0,10" />
                        <local:MyCard x:Name="CardProjects" UseAnimation="False">
                            <StackPanel x:Name="PanProjectList" Margin="12" />
                        </local:MyCard>
                    </StackPanel>
                    <Grid Margin="20,0,20,20" Height="40">
                        <local:MyButton x:Name="BtnMore" HorizontalAlignment="Center" MinWidth="150" Height="36"
                                        Padding="18,0" Text="{DynamicResource Download.ServerPack.LoadMore}"
                                        ColorType="Normal" Click="BtnMore_Click" Visibility="Collapsed" />
                    </Grid>
                </StackPanel>

                <!-- 版本列表视图 -->
                <StackPanel x:Name="PanFiles" Visibility="Collapsed">
                    <local:MyCard Margin="20,20,20,15" Height="62" UseAnimation="False">
                        <local:MyIconButton HorizontalAlignment="Left" Theme="Black" Opacity="0.6" x:Name="BtnBack"
                                            Margin="13,0,0,0" Height="26" Width="26" LogoScale="0.87"
                                            SvgIcon="lucide/arrow-left" />
                        <TextBlock x:Name="LabProjectName" Margin="55,0,16,0" VerticalAlignment="Center"
                                   FontSize="16" TextTrimming="CharacterEllipsis" />
                    </local:MyCard>
                    <local:MyCard Margin="20,0,20,15" Title="{DynamicResource Download.ServerPack.Versions.Title}"
                                  UseAnimation="False">
                        <StackPanel x:Name="PanFileList" Margin="25,40,20,20" />
                    </local:MyCard>
                </StackPanel>
            </Grid>
        </local:MyScrollViewer>
        <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0"
                      SnapsToDevicePixels="True" x:Name="PanLoad" UseAnimation="False">
            <local:MyLoading Text="{DynamicResource Download.ServerPack.Loading}" Margin="20,20,20,17" x:Name="Load"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
        </local:MyCard>
    </Grid>
</local:MyPageRight>