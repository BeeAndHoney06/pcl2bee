<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Class="PCL.PageDownloadServer"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,15" Title="服务端核心下载">
                <StackPanel Margin="25,42,25,20">
                    <TextBlock Text="支持 Paper、Purpur、Spigot 服务端。选择游戏版本后即可下载对应的服务端 jar。"
                               Opacity="0.7" TextWrapping="Wrap" />
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="服务端类型" />
                        <local:MyComboBox x:Name="ComboType" Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                                          SelectionChanged="ComboType_SelectionChanged" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="游戏版本" />
                        <local:MyComboBox x:Name="ComboVersion" Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                                          SelectionChanged="ComboVersion_SelectionChanged" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="构建号" />
                        <local:MyComboBox x:Name="ComboBuild" Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" Orientation="Horizontal">
                            <local:MyButton x:Name="BtnDownload" MinWidth="120" ColorType="Highlight" Text="下载" Click="BtnDownload_Click" />
                            <local:MyButton x:Name="BtnRefresh" MinWidth="90" Margin="10,0,0,0" Text="刷新列表" Click="BtnRefresh_Click" />
                        </StackPanel>
                    </Grid>
                    <local:MyHint x:Name="HintInfo" Margin="0,18,0,0" Theme="Blue"
                                  Text="正在加载版本列表…" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
